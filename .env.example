# AI Support Copilot - Environment Configuration
# Copy this file to .env for local development

# Optional: Real OpenAI LLM Integration
# If left unset, the application automatically runs in deterministic Demo Mode
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

